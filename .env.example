# Copy to .env and fill in as they become available. Nothing here is
# required to render videos today — missing keys just mean the make-video
# skill falls back to placeholders (silent audio timed from script length,
# solid-color or stock backgrounds) and tells you what's missing.

# --- Voiceover (TTS) ---
# ElevenLabs: https://elevenlabs.io
ELEVENLABS_API_KEY=

# --- Captions / forced alignment ---
# OpenAI (Whisper) for word-level timestamps on generated voiceover, enabling
# karaoke-style captions instead of proportional-timing subtitles.
OPENAI_API_KEY=

# --- Images (AI-generated backgrounds, thumbnails) ---
# Any one of these is enough; the skill checks whichever is set.
STABILITY_API_KEY=
REPLICATE_API_TOKEN=

# --- Stock footage / photos ---
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Music ---
# Royalty-free music API, if/when one is chosen.
MUSIC_API_KEY=
